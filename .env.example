# .env.example file for database connection settings

# Database connection settings

DB_USER=db_user
DB_PASSWORD=db_password

DB_SERVER=db_server,port
DB_DATABASE=db_name

DB_DRIVER=db_driver

TABLE_TENTATIVAS=db_table_name

# Logging (opcional: o código já tem defaults)
LOG_LEVEL=INFO
LOG_DIR=logs

# Scraping (opcional: use apenas para sobrescrever os valores padrão do código)
SCRAPING_URL=scraping_url
CHROME_USER_DATA_DIR=caminho/para/diretorio/de/perfil/do/chrome
CHROME_CHANNEL=chrome
CHROME_HEADLESS=false
SCRAPING_DOWNLOAD_FILENAME=tentativas-dito.csv
SCRAPING_ALERT_EMAIL=seu@email.com
